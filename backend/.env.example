# 复制本文件为 backend/.env 后填写真实值（.env 已加入 .gitignore，勿提交仓库）
# 密钥在火山控制台：右上角账号 → 访问密钥（或 访问控制 IAM）

# ---------- 火山 TOS（服务端上传）----------
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_REGION=cn-guangzhou
TOS_ENDPOINT=https://tos-cn-guangzhou.volces.com
TOS_BUCKET=wanx-ai
# 可选：桶自定义域名或固定公网根（不填则按 https://{bucket}.tos-{region}.volces.com 拼直链；公有读桶可直接访问该 URL）
# TOS_PUBLIC_BASE_URL=https://wanx-ai.tos-cn-guangzhou.volces.com
#
# 若浏览器控制台对 TOS 直链报 CORS（fetch 被拦、但 img/video 能显示）：须在 TOS 控制台为本桶配置「跨域访问」
#（来源含 http://localhost:5173 与线上 https 域名；Methods: GET、HEAD）。详见仓库《部署文档》「TOS 跨域」小节。

# Seedance / 视频 API 返回的成片外链往往有时效；任务成功时由服务端下载并写入本桶，再把 result_url 换成 TOS 直链（须已配置上方 TOS）
# VIDEO_RESULT_MIRROR_TOS=0
# VIDEO_TOS_MIRROR_MAX_MB=600
# VIDEO_TOS_MIRROR_TIMEOUT_MS=300000

# 可选
# MAX_UPLOAD_MB=512
# STORAGE_UPLOAD_RATE_PER_MIN=60

# ---------- Seedance 视频生成（创意画布、POST /admin-api/video/jobs）----------
# 默认走 DMXAPI 第三方聚合；回退火山方舟请设 VIDEO_API_PROVIDER=ark
# VIDEO_API_PROVIDER=dmxapi
# VIDEO_API_PROVIDER=ark

# DMXAPI（默认 provider）：https://www.dmxapi.cn 控制台创建 API 令牌
# 文档：https://doc.dmxapi.cn/kaishi.html
ARK_API_KEY=
# 若更愿意用这个变量名也可以，任选其一：
# DMXAPI_API_KEY=
# SEEDANCE_API_KEY=

# DMXAPI Base URL（默认 https://www.dmxapi.cn/v1）
# DMXAPI_API_BASE=https://www.dmxapi.cn/v1
# 查询任务时使用的 model（默认 seedance-2-0-get）
# DMXAPI_QUERY_MODEL=seedance-2-0-get
# DMXAPI 模型目录同步（个人设置页的用户 ID）
# DMXAPI_USER_ID=

# 对话创作「提示词润色」：未在模型商店配置默认文本模型时的兜底 model id（可选）
# PROMPT_POLISH_MODEL=deepseek-chat
# PROMPT_POLISH_TIMEOUT_MS=60000

# 火山方舟（VIDEO_API_PROVIDER=ark 时使用）
# https://console.volcengine.com/ark
# ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# 视频 content 策略（不设环境变量时即为 reference_only，适配 Seedance 2.0 多模态参考）：
# - reference_only（默认）：不走 first_frame/last_frame；参考视频带 role=reference_video，图+视频时参考图带 role=reference_image（见 seedanceClient.js）。
# - auto：仅「1～2 张图且无参考视频」时使用首尾帧 role；经典图生视频/首尾帧专用。
# ARK_VIDEO_CONTENT_MODE=reference_only
# ARK_VIDEO_CONTENT_MODE=auto

# 同一次请求里既有参考图又有参考视频时，可选：强制用下方模型 ID（如 doubao-seedance-2-0-260128；不设则用「视频模型配置」里选中项的 api_model_id）
# ARK_MULTIMODAL_MODEL_ID=doubao-seedance-2-0-260128

# 参考素材数量上限（默认按 2.0 宣传约 9 图 / 3 视频；若模型为 1.x / Lite 请改小）
# ARK_VIDEO_MAX_REF_IMAGES=9
# ARK_VIDEO_MAX_REF_VIDEOS=3
